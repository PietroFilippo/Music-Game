{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "musicgame",
  "version": "0.1.0",
  "identifier": "io.github.pietrofilippo.musicgame",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "musicgame",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sight-reading and fretboard practice for electric guitar",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
